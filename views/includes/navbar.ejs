<script>
  // Sticky header shrink and shadow on scroll (desktop/tablet)
  window.addEventListener('scroll', function() {
    var header = document.getElementById('airbnbStickyHeader');
    if (header) {
      if (window.scrollY > 10) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }
    // Mobile shrink
    var mheader = document.getElementById('airbnbMobileHeader');
    var mcat = document.querySelector('.airbnb-mobile-categories');
    if (mheader && mcat) {
      if (window.scrollY > 10) {
        mheader.classList.add('scrolled');
        mcat.classList.add('scrolled');
      } else {
        mheader.classList.remove('scrolled');
        mcat.classList.remove('scrolled');
      }
    }
  });
</script>

