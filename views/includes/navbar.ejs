           <i class="fa-solid fa-house-chimney" style="color:#FF385C;font-size:2rem;transition:font-size 0.2s;"></i>
          <span class="ms-2 fw-bold airbnb-logo-text" style="color: #FF385C; font-size: 1.5rem; letter-spacing: -1px;transition:font-size 0.2s;">RentNest</span>
