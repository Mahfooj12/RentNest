<% layout('layouts/boilerplate') %>
<div class="container mt-4">
  <h2>My Listings Dashboard</h2>
  <a href="/listings/new" class="btn btn-success mb-3">Add New Listing</a>
  <% if (listings.length === 0) { %>
    <div class="alert alert-info">You have not added any listings yet.</div>
  <% } else { %>
    <div class="row">
      <% listings.forEach(listing => { %>
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <% if (listing.image) { %>
              <img src="<%= listing.image %>" class="card-img-top" alt="Listing Image">
            <% } %>
            <div class="card-body">
              <h5 class="card-title"><%= listing.title %></h5>
              <p class="card-text"><%= listing.location %></p>
              <p class="card-text">₹ <%= listing.price %> per night</p>
              <a href="/listings/<%= listing._id %>" class="btn btn-outline-primary btn-sm">View</a>
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-warning btn-sm">Edit</a>
              <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this listing?');">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <hr>
  <h4>Bookings for My Listings</h4>
  <% if (!bookings || bookings.length === 0) { %>
    <div class="alert alert-info">No bookings for your listings yet.</div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-bordered table-striped">
        <thead>
          <tr>
            <th>Listing</th>
            <th>Guest</th>
            <th>Check-in</th>
            <th>Check-out</th>
            <th>Guests</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.forEach(booking => { %>
            <tr>
              <td><%= booking.listing ? booking.listing.title : 'Listing deleted' %></td>
              <td><%= booking.user ? booking.user.username : 'User deleted' %></td>
              <td><%= booking.checkIn ? booking.checkIn.toDateString() : '' %></td>
              <td><%= booking.checkOut ? booking.checkOut.toDateString() : '' %></td>
              <td><%= booking.guests %></td>
              <td>
                <%= booking.status %>
                <% if (booking.status === 'confirmed') { %>
                  <form action="/bookings/<%= booking._id %>/approve" method="POST" class="d-inline">
                    <button class="btn btn-success btn-sm ms-1">Approve</button>
                  </form>
                  <form action="/bookings/<%= booking._id %>/reject" method="POST" class="d-inline">
                    <button class="btn btn-danger btn-sm ms-1">Reject</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div> 