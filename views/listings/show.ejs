              <div><span class="fw-bold"><%= listing.owner && listing.owner.yearsHosting ? listing.owner.yearsHosting : '1' %></span><br><span class="small text-muted">Year hosting</span></div>
            </div>
            <div class="mt-2">
              <% if (listing.owner && listing.owner.isVerified) { %>
                <span class="badge bg-success"><i class="fa fa-check-circle"></i> Identity verified</span>
              <% } %>
            </div>
            <ul class="list-unstyled mt-3 mb-0">
              <% if (listing.owner && listing.owner.birthYear) { %>
                <li class="mb-1"><i class="fa fa-birthday-cake me-2"></i> Born in <%= listing.owner.birthYear %></li>
              <% } %>
              <% if (listing.owner && listing.owner.work) { %>
                <li class="mb-1"><i class="fa fa-briefcase me-2"></i> My work: <%= listing.owner.work %></li>
              <% } %>
              <% if (listing.owner && listing.owner.funFact) { %>
                <li class="mb-1"><i class="fa fa-music me-2"></i> <%= listing.owner.funFact %></li>
              <% } %>
              <% if (listing.owner && listing.owner.bio) { %>
                <li class="mb-1"><i class="fa fa-user me-2"></i> <%= listing.owner.bio %></li>
              <% } %>
              <% if (listing.owner && listing.owner.languages) { %>
                <li class="mb-1"><i class="fa fa-language me-2"></i> Speaks: <%= listing.owner.languages.join(', ') %></li>
              <% } %>
            </ul>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <h5 class="fw-bold">Co-Hosts</h5>
            <% if (listing.coHosts && listing.coHosts.length > 0) { %>
              <% listing.coHosts.forEach(co => { %>
                <span class="badge rounded-circle bg-dark text-white me-2" style="width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;font-size:1.1rem;">
                  <%= co.username ? co.username.charAt(0).toUpperCase() : '?' %>
                </span>
                <span class="me-3"><%= co.username %></span>
              <% }) %>
            <% } else { %>
              <span class="text-muted">No co-hosts</span>
            <% } %>
          </div>
          <div class="mb-3">
            <h5 class="fw-bold">Host details</h5>
            <div><i class="fa fa-bolt me-2"></i> Response rate: <span class="fw-bold"><%= listing.owner && listing.owner.responseRate ? listing.owner.responseRate : '100%' %></span></div>
            <div><i class="fa fa-clock me-2"></i> Responds within <%= listing.owner && listing.owner.responseTime ? listing.owner.responseTime : 'an hour' %></div>
          </div>
          <a href="#" class="btn btn-dark rounded-pill px-4"><i class="fa fa-envelope me-2"></i>Message host</a>
        </div>
      </div>
      <hr class="my-5">
    </div> -->
    <div class="mt-5">
      <h4 class="fw-bold">Reviews</h4>
      <% if (currUser) { %>
        <form method="POST" action="/listings/<%= listing._id %>/reviews" class="mb-4">
          <div class="row g-2 align-items-end">
            <div class="col-md-2">
              <label for="rating" class="form-label">Rating</label>
              <select class="form-select rounded-pill" id="rating" name="review[rating]" required>
                <option value="">Select</option>
                <% for (let i = 1; i <= 5; i++) { %>
                  <option value="<%= i %>"><%= i %> Star<%= i > 1 ? 's' : '' %></option>
                <% } %>
              </select>
            </div>
            <div class="col-md-7">
              <label for="comment" class="form-label">Comment</label>
              <textarea class="form-control rounded-4" id="comment" name="review[comment]" rows="1" required></textarea>
            </div>
            <div class="col-md-3">
              <button class="btn btn-outline-primary rounded-pill w-100">Submit Review</button>
            </div>
          </div>
        </form>
      <% } %>
      <% if (listing.reviews.length === 0) { %>
        <div class="alert alert-info">No reviews yet.</div>
      <% } else { %>
        <div class="row">
          <% listing.reviews.forEach(review => { %>
            <div class="col-md-6 mb-3">
              <div class="card shadow-sm rounded-4">
                <div class="card-body">
                  <h6 class="card-title mb-1">@<%= review.author ? review.author.username : 'Unknown' %></h6>
                  <div class="mb-1">Rating: <span class="fw-bold"><%= review.rating %></span> / 5</div>
                  <p class="card-text"><%= review.comment %></p>
                  <% if (currUser && review.author && currUser._id.toString() === review.author._id.toString()) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline">
                      <button class="btn btn-danger btn-sm rounded-pill">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
      <hr>
      <h4 class="fw-bold">Map Location</h4>
      <div id="map" style="height: 400px;" class="mb-5 rounded-4 shadow-sm"></div>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script>
        const coordinates = [<%= listing.geometry.coordinates[1] %>, <%= listing.geometry.coordinates[0] %>];
        const title = "<%= listing.title %>";
        const map = L.map('map').setView(coordinates, 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '© OpenStreetMap'
        }).addTo(map);
        L.marker(coordinates).addTo(map).bindPopup(title).openPopup();
      </script>
      <a href="https://www.google.com/maps?q=<%= listing.geometry.coordinates[1] %>,<%= listing.geometry.coordinates[0] %>" target="_blank" class="btn btn-primary mt-3 rounded-pill">View on Google Maps</a>
    <% } %>
  </div>
</body>
</html>
