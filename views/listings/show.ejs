<% layout('layouts/boilerplate') %>

<body>
  <div class="container mt-4">
    <div class="row">
      <div class="col-md-7">
        <% if (listing.image) { %>
          <img src="<%= listing.image %>" class="img-fluid rounded-4 mb-3 shadow-sm" style="aspect-ratio: 4/3; object-fit: cover;" alt="Listing Image">
        <% } %>
        <h2 class="fw-bold mb-1"><%= listing.title %></h2>
        <p class="text-muted mb-2" style="font-size:1.1rem;"><i class="fa fa-location-dot me-1"></i> <%= listing.location %></p>
        <p class="mb-2"><%= listing.description %></p>
        <div class="mb-2"><strong>Price:</strong> <span class="fw-bold">₹ <%= listing.price %></span> <span class="text-muted">/ night</span></div>
        <div class="mb-2"><strong>Guests:</strong> <%= listing.guests %></div>
        <div class="mb-3"><strong>Host:</strong> <%= listing.owner ? listing.owner.username : 'Unknown' %></div>
        <% if (currUser && listing.owner && currUser._id.toString() === listing.owner._id.toString()) { %>
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning rounded-pill me-2">Edit</a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger rounded-pill" onclick="return confirm('Are you sure you want to delete this listing?');">Delete</button>
          </form>
        <% } else if (currUser) { %>
          <a href="/listings/<%= listing._id %>/book" class="btn btn-success rounded-pill">Book Now</a>
        <% } %>
      </div>
      <!-- Meet your host section 
