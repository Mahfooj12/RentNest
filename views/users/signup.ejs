<% layout('layouts/boilerplate') %>
<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="p-4 rounded-4 shadow-sm bg-white border-0 airbnb-form-card">
        <h2 class="fw-bold mb-2 text-center">Sign Up</h2>
        <p class="text-muted mb-4 text-center">Create your account to start exploring amazing stays.</p>
        <form method="POST" action="/signup" novalidate class="needs-validation">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" name="username" class="form-control rounded-pill" id="username" required>
            <div class="valid-feedback">Looks good!</div>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" name="email" class="form-control rounded-pill" id="email" required>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" name="password" class="form-control rounded-pill" id="password" required>
            <div class="valid-feedback">Looks good!</div>
          </div>
          <button class="btn btn-pink rounded-pill w-100 py-2 fs-5">Sign Up</button>
        </form>
      </div>
    </div>
  </div>
</div>
<style>
.airbnb-form-card {
  border-radius: 2rem;
  box-shadow: 0 4px 24px rgba(0,0,0,0.10);
  border: 1px solid #f1f1f1;
}
</style>