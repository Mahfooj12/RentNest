<% layout('layouts/boilerplate') %>
<div class="container mt-4">
  <h2>My Profile</h2>
  <div class="mb-4">
    <h5>Username: <%= user.username %></h5>
    <h6>Email: <%= user.email %></h6>
    <h6>Role: <%= user.role %></h6>
  </div>
  <hr>
  <h4>My Bookings</h4>
  <% if (bookings.length === 0) { %>
    <div class="alert alert-info">You have no bookings yet.</div>
  <% } else { %>
    <div class="row">
      <% bookings.forEach(booking => { %>
        <div class="col-md-6 mb-3">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title"><%= booking.listing ? booking.listing.title : 'Listing deleted' %></h5>
              <p>Check-in: <%= booking.checkIn.toDateString() %></p>
              <p>Check-out: <%= booking.checkOut.toDateString() %></p>
              <p>Guests: <%= booking.guests %></p>
              <p>Status: <%= booking.status %></p>
              <% if (booking.status === 'confirmed') { %>
                <form action="/bookings/<%= booking._id %>/cancel" method="POST">
                  <button class="btn btn-danger btn-sm">Cancel Booking</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
  <hr>
  <h4>Booking History</h4>
  <% if (!bookingHistory || bookingHistory.length === 0) { %>
    <div class="alert alert-info">No past or cancelled bookings.</div>
  <% } else { %>
    <div class="row">
      <% bookingHistory.forEach(booking => { %>
        <div class="col-md-6 mb-3">
          <div class="card border-secondary">
            <div class="card-body">
              <h5 class="card-title"><%= booking.listing ? booking.listing.title : 'Listing deleted' %></h5>
              <p>Check-in: <%= booking.checkIn.toDateString() %></p>
              <p>Check-out: <%= booking.checkOut.toDateString() %></p>
              <p>Guests: <%= booking.guests %></p>
              <p>Status: <%= booking.status %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
  <hr>
  <h4>My Listings</h4>
  <% if (listings.length === 0) { %>
    <div class="alert alert-info">You have not added any listings yet.</div>
  <% } else { %>
    <div class="row">
      <% listings.forEach(listing => { %>
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <% if (listing.image) { %>
              <img src="<%= listing.image %>" class="card-img-top" alt="Listing Image">
            <% } %>
            <div class="card-body">
              <h5 class="card-title"><%= listing.title %></h5>
              <p class="card-text"><%= listing.location %></p>
              <p class="card-text">₹ <%= listing.price %> per night</p>
              <a href="/listings/<%= listing._id %>" class="btn btn-outline-primary btn-sm">View</a>
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-warning btn-sm">Edit</a>
              <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this listing?');">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div> 